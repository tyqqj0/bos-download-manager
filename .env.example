# DLM - Dataset Download Manager
# Copy to .env and fill in real values: cp .env.example .env

# Baidu Cloud credentials (required)
BAIDU_AK=your_access_key_here
BAIDU_SK=your_secret_key_here
BOS_ENDPOINT=https://bj.bcebos.com

# HuggingFace token (required for gated repos)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
