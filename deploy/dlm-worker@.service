[Unit]
Description=DLM Temporal Worker (%i)
After=network.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/code/bos-download-manager
EnvironmentFile=-/root/.env
ExecStart=/bin/bash -c 'set -a; [ -f /root/.env ] && source /root/.env; [ -f .env ] && source .env; set +a; exec python3 -m dlm.temporal --server-key %i --temporal-host 154.85.43.52:7233'
Restart=always
RestartSec=10
StandardOutput=append:/var/log/dlm-worker.log
StandardError=append:/var/log/dlm-worker.log

[Install]
WantedBy=multi-user.target
